# ============================================================================

# Flutter / Dart .gitignore

# ============================================================================

# Do not remove or rename Flutter repository-specific entries.

# Only add new entries when required.

#

# Flutter reference:

# https://github.com/flutter/flutter/issues/128635

# ============================================================================

# ----------------------------------------------------------------------------

# Miscellaneous

# ----------------------------------------------------------------------------

*.class
*.log
*.pyc
*.swp
*.swo
*.tmp
*.temp
*.bak
*.orig
*.rej

.DS_Store
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

.atom/
.buildlog/
.history/
.svn/
.cxx/

# Temporary / diagnostic files

*.pid
*.pid.lock
*.seed
*.stackdump
*.trace

# ----------------------------------------------------------------------------

# IntelliJ / Android Studio

# ----------------------------------------------------------------------------

*.iml
*.ipr
*.iws
.idea/

# Keep shared project configuration if used by the team

!.idea/codeStyles/
!.idea/runConfigurations/

# ----------------------------------------------------------------------------

# Visual Studio Code

# ----------------------------------------------------------------------------

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/launch.json
!.vscode/tasks.json

# ----------------------------------------------------------------------------

# Eclipse

# ----------------------------------------------------------------------------

.classpath
.project
.settings/

# ----------------------------------------------------------------------------

# Flutter repo-specific

# ----------------------------------------------------------------------------

/bin/cache/
/bin/internal/bootstrap.bat
/bin/internal/bootstrap.sh
/bin/mingit/
/dev/benchmarks/mega_gallery/
/dev/bots/.recipe_deps
/dev/bots/android_tools/
/dev/devicelab/ABresults*.json
/dev/docs/doc/
/dev/docs/api_docs.zip
/dev/docs/flutter.docs.zip
/dev/docs/lib/
/dev/docs/pubspec.yaml
/dev/integration_tests/**/xcuserdata
/dev/integration_tests/**/Pods
/packages/flutter/coverage/
version
analysis_benchmark.json

# Packages file containing multi-root paths

.packages.generated

# ----------------------------------------------------------------------------

# Dart / Flutter / Pub

# ----------------------------------------------------------------------------

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/generated_plugin_registrant.dart
.packages
.pub-preload-cache/
.pub-cache/
.pub/
build/

# Flutter generated files

flutter_*.png
linked_*.ds
unlinked.ds
unlinked_spec.ds

# Flutter ephemeral files

**/flutter/ephemeral/
**/Flutter/ephemeral/

# ----------------------------------------------------------------------------

# FVM

# ----------------------------------------------------------------------------

# Keep .fvmrc committed so the team uses the same Flutter version.

.fvm/flutter_sdk

# ----------------------------------------------------------------------------

# Environment / Secrets

# ----------------------------------------------------------------------------

.env
.env.*
!.env.example
!.env.template
!.env.sample

**/env/.env
**/env/.env.*
**/.env
**/.env.*

# Local configuration

local.properties
local_config.*
config.local.*
*.local

# ----------------------------------------------------------------------------

# Android

# ----------------------------------------------------------------------------

.gradle/
**/.gradle/

# Gradle wrapper generated files

**/android/**/gradle-wrapper.jar

# Android local configuration

**/android/local.properties

# Android generated files

**/android/**/captures/
**/android/**/GeneratedPluginRegistrant.java
**/android/**/build/
**/android/**/.cxx/
**/android/**/.externalNativeBuild/
**/android/**/obj/

# Gradle executables

**/android/gradlew
**/android/gradlew.bat

# Android signing configuration

**/android/key.properties
**/android/**/key.properties

# Android signing certificates / keystores

*.jks
*.keystore
*.p12
*.pfx

# Native build output

**/android/**/cmake-build-*/

# ----------------------------------------------------------------------------

# iOS / Xcode

# ----------------------------------------------------------------------------

# Xcode user-specific files

**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/xcuserdata/
**/ios/**/DerivedData/

# General Xcode user data

**/xcuserdata/

# Xcode generated files

**/ios/**/Icon?
**/ios/.generated/
**/ios/Flutter/.last_build_id

# Flutter iOS generated files

**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/

# Generated plugin registration

**/ios/Runner/GeneratedPluginRegistrant.*

# CocoaPods

**/Pods/
**/ios/Pods/

# Keep Podfile.lock committed

!**/ios/Podfile.lock

# Xcode build output

**/ios/build/
**/ios/DerivedData/

# Swift Package Manager

**/.swiftpm/
**/ios/.swiftpm/

# Xcode archives

*.xcarchive
*.dSYM
*.dSYM.zip

# iOS signing / provisioning

*.mobileprovision
*.provisionprofile
*.cer
*.p12

# Generated service definitions

**/ios/ServiceDefinitions.json

